rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isFriend(uid) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid));
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['height', 'heightCm', 'weight', 'weightKg', 'body']);
      allow delete: if isOwner(uid);
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /history/{logId} {
        allow read: if isOwner(uid) || isFriend(uid);
        allow create, update, delete: if isOwner(uid)
          && !request.resource.data.keys().hasAny(['height', 'heightCm', 'weight', 'weightKg', 'body']);
      }
      match /friends/{friendId} {
        allow read: if isOwner(uid) || (signedIn() && request.auth.uid == friendId);
        allow create, update, delete: if isOwner(uid);
      }
    }
    match /challenges/{challengeId} {
      function party() {
        return signedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      }
      function clean(data) {
        return !data.keys().hasAny(['height', 'heightCm', 'weight', 'weightKg', 'body']);
      }
      allow read: if party();
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'ban'
        && request.resource.data.banned == null
        && request.resource.data.drafted.size() == 3
        && clean(request.resource.data);
      allow update: if party()
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && request.resource.data.drafted == resource.data.drafted
        && request.resource.data.path == resource.data.path
        && request.resource.data.day == resource.data.day
        && clean(request.resource.data);
    }
  }
}
